{
  "expo": {
    "name": "app-undercontroll",
    "slug": "app-undercontroll",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/logo_pelluci.png",
      "resizeMode": "contain",
      "backgroundColor": "#061d2d"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "A Pelluci usa o microfone para transcrever observações da ordem de serviço."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "enableBackgroundRecording": false,
          "microphonePermission": "A Pelluci usa o microfone para transcrever observações da ordem de serviço."
        }
      ]
    ]
  }
}
